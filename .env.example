# Copy to .env (START.bat does this automatically). Never commit .env.
# The Settings page in the UI can write the API key here for you.

# --- server ---
INSTAI_HOST=127.0.0.1
INSTAI_PORT=8765
# Django secret key; START.bat generates one on first run if empty
INSTAI_SECRET_KEY=
INSTAI_DEBUG=0
# Where user data lives (database, media, logs). Defaults to <project>\data
# INSTAI_DATA_DIR=

# --- text provider: fake | ollama | openai ---
INSTAI_LLM_PROVIDER=ollama
INSTAI_OLLAMA_URL=http://127.0.0.1:11434
INSTAI_OLLAMA_MODEL=
# OpenAI-compatible API (e.g. MetisAI). Base URL must end before /chat/completions
INSTAI_OPENAI_BASE_URL=
INSTAI_OPENAI_API_KEY=
INSTAI_OPENAI_MODEL=

# --- local services ---
INSTAI_COMFYUI_URL=http://127.0.0.1:8188
INSTAI_PIPER_URL=
INSTAI_MOSS_TTS_URL=
# Folder of an existing ComfyUI install (used by the model downloader to reuse files)
# COMFYUI_DIR=

# --- worker ---
INSTAI_WORKER_CPU_THREADS=2
